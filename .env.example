# ==============================================================================
# JimRouteLLM Configuration (.env)
# ==============================================================================

# --- Proxy Server Settings ---
PROXY_HOST=0.0.0.0
PROXY_PORT=8000
PROXY_API_KEY=

# --- Primary Cloud Provider (Google AI Studio / Gemini) ---
DEFAULT_CLOUD_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_TIER_THRESHOLD=0.60

# --- Anthropic Claude (Cloud Provider - Kept for future use) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_STRONG_MODEL=claude-fable-5
CLAUDE_OPUS_MODEL=claude-opus-5
CLAUDE_SONNET_MODEL=claude-sonnet-5
CLAUDE_OPUS_THRESHOLD=0.65

# --- Routing Engine & ModernBERT-Large Classifier ---
ROUTER_TYPE=modernbert
ROUTING_THRESHOLD=0.45
MODERNBERT_MODEL_ID=answerdotai/ModernBERT-large
MODERNBERT_USE_ONNX=true
NPU_ENABLED=true

# --- Local Target Models (LM Studio @ 127.0.0.1:1234) ---
LOCAL_EASY_MODEL=google/gemma-4-12b-qat
LOCAL_HARD_MODEL=meta/muse-glimmer
LOCAL_VISION_MODEL=meta/muse-glimmer
LOCAL_LM_STUDIO_URL=http://127.0.0.1:1234/v1

# --- Heterogeneous LAN Cluster Configuration ---
# Format: JSON array of node definitions with specific models & capabilities
LAN_NODES='[
  {
    "id": "zbook-gemma",
    "name": "HP ZBook Gemma 4 12B (Local)",
    "base_url": "http://127.0.0.1:1234/v1",
    "primary_model": "google/gemma-4-12b-qat",
    "capabilities": ["code", "text", "vision", "multimodal", "thinking", "fast", "easy"],
    "priority": 1
  },
  {
    "id": "zbook-muse",
    "name": "HP ZBook Muse Glimmer (Local)",
    "base_url": "http://127.0.0.1:1234/v1",
    "primary_model": "meta/muse-glimmer",
    "capabilities": ["heavy", "reasoning", "vision", "multimodal", "thinking", "hard"],
    "priority": 1
  },
  {
    "id": "lan-node-2",
    "name": "LAN Workstation 2",
    "base_url": "http://192.168.1.100:1234/v1",
    "primary_model": "deepseek-coder-v2-lite-instruct",
    "capabilities": ["code", "text"],
    "priority": 2
  },
  {
    "id": "lan-node-3",
    "name": "LAN Heavy Compute 3",
    "base_url": "http://192.168.1.101:1234/v1",
    "primary_model": "llama-3.3-70b-instruct",
    "capabilities": ["heavy", "text", "reasoning"],
    "priority": 3
  },
  {
    "id": "lan-node-4-vision",
    "name": "LAN Vision Node 4",
    "base_url": "http://192.168.1.102:1234/v1",
    "primary_model": "qwen2-vl-7b-instruct",
    "capabilities": ["vision", "multimodal"],
    "priority": 4
  }
]'

# Dedicated Vision Fallback
LM_STUDIO_VISION_URL=http://127.0.0.1:1234/v1
LM_STUDIO_VISION_MODEL=meta/muse-glimmer

# --- MCP Tool Routing (Active SearXNG + Playwright headless Chrome) ---
ENABLE_MCP_ROUTING=true
MCP_ROUTING_MODE=filter
MCP_SERVERS_FILE=mcpServers.json
MCP_CACHE_TTL_SECONDS=300
